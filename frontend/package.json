{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "check": "bun --bun svelte-check --tsconfig ./tsconfig.app.json && bun --bun svelte-check --tsconfig ./tsconfig.tests.json && bun --bun tsc -p tsconfig.node.json",
    "test": "bun test ./tests",
    "format": "bun --bun prettier --write --log-level warn .",
    "format:check": "bun --bun prettier --check --log-level warn .",
    "probe": "bun probes/run.mjs",
    "docs:dev": "bun --bun --no-install vitepress dev ../docs",
    "docs:build": "bun --bun --no-install vitepress build ../docs",
    "docs:preview": "bun --bun --no-install vitepress preview ../docs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.13.3",
    "@types/three": "^0.186.0",
    "bun-types": "^1.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitepress": "1.6.4"
  },
  "dependencies": {
    "meshoptimizer": "^1.3.0",
    "recast-navigation": "0.43.1",
    "simplex-noise": "^4.0.3",
    "smol-toml": "^1.9.1",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.16",
    "wasmoon": "^1.16.0"
  }
}
