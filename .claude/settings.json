{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "[ \"$CLAUDE_CODE_REMOTE\" = true ] && \"$CLAUDE_PROJECT_DIR\"/scripts/setup-linux.sh || true"
					}
				]
			}
		],
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "command -v bun >/dev/null 2>&1 || exit 0; bun \"$CLAUDE_PROJECT_DIR\"/scripts/block-heredoc-script.mjs"
					}
				]
			}
		]
	}
}
